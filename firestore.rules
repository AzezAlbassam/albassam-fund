rules_version = '2';

// ============================================================
// COMPLETE ruleset for Firebase project "albassam-fund".
// Firestore has ONE ruleset per project, so this file covers
// BOTH apps sharing it:
//   /trades/**       — Albassam Fund (stock calls tracker)
//   /familyOffice/** — Albassam Private Family Office
//   /portfolios/**, /racers/**, /members/**, /joinRequests/** — old family race (closed, data kept)
// Keep this file identical in the albassam-fund and
// albassam-office repos; deploying from either then yields the
// same ruleset.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'azizbassam2018@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Albassam Fund: trades tracker.
    match /trades/{tradeId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Albassam Fund: shared settings (simulator starting pot etc.).
    match /meta/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Old family race. The Family section was removed 2026-11-16: the data
    // stays, nobody can add or change it. /portfolios/{uid} (holdings sealed
    // with the member's passcode) is that member's only; /racers/{uid} (a
    // name and a return %) is no longer public, only the manager and that
    // member see it. Members may still delete their own docs.
    // To bring the board back, restore the write rules from albassam-fund commit bcfaee1 (albassam-office 402d98b).
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /members/{email} {
      allow read: if isOwner() || (request.auth != null && request.auth.token.email == email);
      allow write: if isOwner();
    }

    match /joinRequests/{uid} {
      allow read, delete: if isOwner() || isSelf(uid);
      allow create, update: if false;
    }

    match /portfolios/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if false;
    }

    match /racers/{uid} {
      allow read, delete: if isOwner() || isSelf(uid);
      allow create, update: if false;
    }

    // Albassam Private Family Office: config doc + subcollections
    // (members, ledger, history, plan). Private since 2026-09-28:
    // reading AND writing require the steward's verified Google account.
    match /familyOffice/{doc} {
      allow read, write: if isOwner();

      match /{collection}/{entryId} {
        allow read, write: if isOwner();
      }
    }

    // Everything else: locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
